# Copy this file to /etc/zopen-package-requests.env on the server, restrict it
# to root, and replace every placeholder. Never commit the live file.
HOST=127.0.0.1
PORT=3100
DATABASE_PATH=/var/lib/zopen-package-requests/requests.db
ALLOWED_ORIGINS=https://zopen.community,https://zopencommunity.github.io
ADMIN_TOKEN=replace-with-a-random-secret
TRUST_PROXY=true
