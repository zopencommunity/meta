[Unit]
Description=zopen package requests API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zopenreq
Group=zopenreq
WorkingDirectory=/opt/zopen-meta/web/package_requests_server
EnvironmentFile=/etc/zopen-package-requests.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zopen-package-requests

[Install]
WantedBy=multi-user.target
