# zopen-specific RPM macro overrides
# Created by: zopen-init
# Location: ${ZOPEN_ROOTFS}/etc/rpm/macros.zopen
#
# This file configures RPM to use persistent directories that survive
# package reinstallation.

#==============================================================================
# CRITICAL PERSISTENT PATHS
# These directories must be outside the versioned RPM package directory
#==============================================================================

# Base directories - persistent across reinstalls
%_var                   %{getenv:ZOPEN_ROOTFS}/var
%_usr                   %{getenv:ZOPEN_ROOTFS}/usr

# RPM database - MUST be persistent!
%_dbpath                %{_var}/lib/rpm
%_dbpath_rebuild        %{_dbpath}

# Temporary files
%_tmppath               %{_var}/tmp

# System configuration - persistent
%_sysconfdir            %{getenv:ZOPEN_ROOTFS}/etc

# Local state directory
%_localstatedir         %{_var}

#==============================================================================
# INSTALLATION PREFIX
# Point to zopen root for FHS-like structure
#==============================================================================

%_prefix                %{getenv:ZOPEN_ROOTFS}/usr/local
%_exec_prefix           %{_prefix}

#==============================================================================
# BUILD WORKSPACE
# Standard RPM behavior - uses user's home directory
#==============================================================================

%_topdir                %{getenv:HOME}/rpmbuild
%_builddir              %{_topdir}/BUILD
%_rpmdir                %{_topdir}/RPMS
%_sourcedir             %{_topdir}/SOURCES
%_specdir               %{_topdir}/SPECS
%_srcrpmdir             %{_topdir}/SRPMS

#==============================================================================
# RPM-SPECIFIC PATHS
# Relative to _dbpath for persistence
#==============================================================================

%_keyringpath           %{_dbpath}/pubkeys/
%_keyring_lockpath      %{_dbpath}/.keyring.lock
%_rpmlock_path          %{_dbpath}/.rpm.lock

#==============================================================================
# NOTES:
#
# %{getenv:ZOPEN_ROOTFS} reads ZOPEN_ROOTFS from environment
# 
# User overrides: Create ~/.config/rpm/macros
# System overrides: Edit %{getenv:ZOPEN_ROOTFS}/etc/rpm/macros
# Per-build: Use rpm --define "macro value"
#
# Verify with: rpm --eval "%{_var}" or rpm --eval "%{_dbpath}"
#==============================================================================
